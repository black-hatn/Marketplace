generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Brand {
  id          String    @id @default(uuid())
  slug        String    @unique
  name        String
  title       String
  tagline     String
  description String
  story       String
  values      String
  impact      String
  image       String
  email       String    @unique
  password    String
  phone       String?
  airtelMoney String?
  moovMoney   String?
  isVerified  Boolean   @default(false)
  views       Int       @default(0)
  banner      String?
  themeColor  String    @default("#06B6D4") // Cyan-500 par défaut
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  produits    Produit[]
  coupons     Coupon[]
  notifications Notification[]
  wallet      Wallet?
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  produits    Produit[]
}

model Wishlist {
  id        String   @id @default(cuid())
  sessionId String
  productId String
  createdAt DateTime @default(now())
  produit   Produit  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([sessionId, productId])
}

// --- ENUMS ---

enum Role {
  CLIENT
  ADMIN
}

enum StatutPanier {
  ACTIF
  ABANDONNE
  CONVERTI
}

enum StatutCommande {
  EN_ATTENTE
  PAYEE
  VALIDEE
  EXPEDIEE
  LIVREE
  ANNULEE
}

enum StatutPaiement {
  EN_ATTENTE
  REUSSI
  ECHOUE
}

enum MethodePaiement {
  STRIPE
  PAYPAL
  AIRTEL
  MOOV
}

// --- ENTITÉS ---

model Client {
  id               String    @id @default(cuid())
  email            String    @unique
  mot_de_passe_hash String
  nom              String
  prenom           String
  telephone        String?
  role             Role      @default(CLIENT)
  image            String?
  anonymise        Boolean   @default(false) // RGPD
  date_inscription DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  
  adresses_livraison Adresse[]
  paniers            Panier[]
  commandes          Commande[]

  @@index([email])
}

model Adresse {
  id         String @id @default(cuid())
  rue        String
  ville      String
  code_postal String
  pays       String @default("Tchad")
  client_id  String
  client     Client @relation(fields: [client_id], references: [id], onDelete: Cascade)
}

model Produit {
  id            String   @id @default(cuid())
  sku           String   @unique // Indexé pour perfs
  nom           String
  description   String   @db.Text
  prix_ht       Decimal  @db.Decimal(12, 2)
  tva           Decimal  @db.Decimal(5, 2) @default(18.00)
  prix_ttc      Decimal  @db.Decimal(12, 2)
  stock         Int      @default(0)
  images        String[]
  categories    String[]
  actif         Boolean  @default(true)
  rating        Float    @default(4.5)
  reviews       Int      @default(0)
  threeDStyle   String?  @default("cube")
  date_creation DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  brandId       String?
  brand         Brand?   @relation(fields: [brandId], references: [id])
  categoryId    String?
  category      Category? @relation(fields: [categoryId], references: [id])

  lignes_panier    LignePanier[]
  lignes_commande  LigneCommande[]
  wishlists        Wishlist[]
  avis             Review[]
  variantes        Variante[]

  @@index([sku])
}

// P — Variantes produit (couleur, taille, version…)
model Variante {
  id         String   @id @default(cuid())
  produit_id String
  produit    Produit  @relation(fields: [produit_id], references: [id], onDelete: Cascade)
  nom        String   // ex: "Taille L", "Couleur Bleu"
  valeur     String   // ex: "L", "Bleu"
  stock      Int      @default(0)
  prix_delta Decimal  @db.Decimal(12, 2) @default(0) // supplément/réduction par rapport au produit
  sku_suffix String?  // ex: "-L-BLU"
  actif      Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([produit_id])
}

model Panier {
  id            String       @id @default(cuid())
  client_id     String?      // Nullable pour Guest
  client        Client?      @relation(fields: [client_id], references: [id])
  session_id    String       @unique
  statut        StatutPanier @default(ACTIF)
  date_creation DateTime     @default(now())
  date_modif    DateTime     @updatedAt
  
  lignes_panier LignePanier[]
}

model LignePanier {
  id            String  @id @default(cuid())
  panier_id     String
  panier        Panier  @relation(fields: [panier_id], references: [id], onDelete: Cascade)
  produit_id    String
  produit       Produit @relation(fields: [produit_id], references: [id])
  quantite      Int
  prix_unitaire_fige Decimal @db.Decimal(12, 2)
}

model Commande {
  id                 String         @id @default(cuid())
  numero_commande     String         @unique // Indexé pour perfs
  client_id           String
  client              Client         @relation(fields: [client_id], references: [id])
  adresse_livraison   String         @db.Text
  adresse_facturation String         @db.Text
  statut              StatutCommande @default(EN_ATTENTE)
  montant_total       Decimal        @db.Decimal(12, 2)
  numero_suivi        String?        // Numéro de suivi transporteur (#18)
  date_commande       DateTime       @default(now())
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  lignes_commande    LigneCommande[]
  paiements          Paiement[]

  @@index([numero_commande])
  @@index([statut])
  @@index([date_commande])
}

model LigneCommande {
  id              String   @id @default(cuid())
  commande_id     String
  commande        Commande @relation(fields: [commande_id], references: [id], onDelete: Cascade)
  produit_id      String
  produit         Produit  @relation(fields: [produit_id], references: [id])
  quantite        Int
  prix_unitaire_ht Decimal  @db.Decimal(12, 2)
  tva_appliquee   Decimal  @db.Decimal(5, 2)
}

model Paiement {
  id                    String          @id @default(cuid())
  commande_id           String
  commande              Commande        @relation(fields: [commande_id], references: [id])
  montant               Decimal         @db.Decimal(12, 2)
  methode               MethodePaiement
  statut                StatutPaiement  @default(EN_ATTENTE)
  transaction_id_stripe String?         @unique
  date_paiement         DateTime?
}

model Review {
  id         String   @id @default(cuid())
  produit_id String
  produit    Produit  @relation(fields: [produit_id], references: [id], onDelete: Cascade)
  clientId   String?  // Lien vers Client pour empêcher les doublons (#5)
  rating     Int
  comment    String   @db.Text
  userName   String
  reply      String?  @db.Text
  createdAt  DateTime @default(now())

  @@unique([produit_id, clientId]) // Un avis par client par produit
}

model Notification {
  id        String   @id @default(cuid())
  userId    String?
  brandId   String?
  type      String   // ORDER, STOCK, SYSTEM, REVIEW
  title     String
  message   String   @db.Text
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  
  brand     Brand?   @relation(fields: [brandId], references: [id])
}

model Coupon {
  id          String   @id @default(cuid())
  code        String   @unique
  discount    Float    // Pourcentage ou fixe
  type        String   @default("PERCENTAGE") // PERCENTAGE ou FIXED
  expiresAt   DateTime
  isActive    Boolean  @default(true)
  maxUses     Int?     // null = illimité (#10)
  usedCount   Int      @default(0) // (#10)
  brandId     String
  brand       Brand    @relation(fields: [brandId], references: [id])
  createdAt   DateTime @default(now())
}

model Wallet {
  id        String   @id @default(cuid())
  balance   Decimal  @db.Decimal(12, 2) @default(0)
  brandId   String   @unique
  brand     Brand    @relation(fields: [brandId], references: [id])
  updatedAt DateTime @updatedAt
  requests  WithdrawalRequest[]
}

model WithdrawalRequest {
  id        String   @id @default(cuid())
  amount    Decimal  @db.Decimal(12, 2)
  method    String   // AIRTEL, MOOV
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  walletId  String
  wallet    Wallet   @relation(fields: [walletId], references: [id])
  createdAt DateTime @default(now())
}
